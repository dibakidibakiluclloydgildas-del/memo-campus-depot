# =============================================================================
# MÉMO CAMPUS — variables d'environnement (modèle, sans aucun secret réel)
# Copiez ce fichier en `.env` à la racine puis renseignez vos propres valeurs.
#   cp .env.example .env
# Le fichier `.env` ne doit JAMAIS être versionné.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# --- Base de données PostgreSQL (extension pgvector obligatoire) --------------
# Local :  postgresql://memo:motdepasse@127.0.0.1:5432/memo_campus?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/memo_campus?schema=public
# Base dédiée aux tests d'intégration (recréée par la CI, jamais la base réelle)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/memo_campus_test?schema=public

# --- Sécurité ----------------------------------------------------------------
# Générez une valeur unique : openssl rand -base64 48
JWT_SECRET=changez_moi_avec_openssl_rand_base64_48
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
# Limitation de débit globale (requêtes par fenêtre, par IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Files d'attente (facultatif : l'API fonctionne sans Redis) -------------
REDIS_URL=redis://127.0.0.1:6379

# --- Stockage des fichiers ---------------------------------------------------
# local = disque du serveur ; s3 = tout stockage compatible S3 (MinIO, R2, B2…)
STORAGE_DRIVER=local
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=25
# Si STORAGE_DRIVER=s3 :
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Intelligence artificielle (mode démonstration par défaut) ---------------
# demo      : moteur extractif local, aucune clé, aucun coût, réponses citées
# openai    : GPT (OPENAI_API_KEY requise)
# google    : Gemini (GOOGLE_API_KEY requise)
# anthropic : Claude (ANTHROPIC_API_KEY requise)
AI_PROVIDER=demo
AI_DEMO_MODE=true
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
# Embeddings : `local` = calcul déterministe sur l'appareil (0 €) ; `openai` = API
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_DIM=768
# Plafonds de coût par compte (protection contre les dérives de facturation)
AI_MONTHLY_BUDGET_USD=5

# --- Envoi d'e-mails (réinitialisation de mot de passe) ----------------------
# Sans SMTP_URL, le jeton de réinitialisation est renvoyé par l'API en
# développement uniquement (jamais en production).
SMTP_URL=
MAIL_FROM=no-reply@memo-campus.cm

# --- Paiements (aucun abonnement n'est activé sans webhook signé) -----------
# Cameroun : Campay (Orange Money / MTN MoMo)
CAMPY_BASE_URL=https://demo.campay.net/api
CAMPY_APP_ID=
CAMPY_APP_SECRET=
CAMPY_WEBHOOK_SECRET=
# Cartes bancaires : Stripe (mode test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications (Android) -------------------------------------------------
# Rappels locaux : aucune configuration. Push distant : compte Firebase requis.
FCM_SERVER_KEY=

# --- Partage / démonstration ------------------------------------------------
# Autorise le bouton « Entrer en mode démonstration (un clic) » sur la page de
# connexion. Actif par défaut hors production, DÉSACTIVÉ en production sauf
# si vous le mettez explicitement à true (à réserver aux instances de test).
ALLOW_DEMO_LOGIN=true
DEMO_STUDENT_EMAIL=etudiant@demo.memo-campus.cm
DEMO_STUDENT_PASSWORD=MemoCampus2026!

# --- Web (Next.js) -----------------------------------------------------------
# Adresse interne de l'API, utilisée côté serveur uniquement (jamais exposée au navigateur)
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Android (Expo) ----------------------------------------------------------
# Émulateur : http://10.0.2.2:4000 — téléphone physique : IP de la machine
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
